{
  "project": {
    "baseBranch": "dev",
    "codeExt": ".ts",
    "codeDirs": [
      "src",
      "test"
    ],
    "docsDir": "docs"
  },
  "codelint": {
    "lintDirs": [
      "src"
    ],
    "maxLinesWarning": 500,
    "maxLinesError": 1200
  },
  "doclint": {
    "maxLinesWarning": 200,
    "maxLinesError": 500
  },
  "docsGardener": {
    "catalogs": {}
  },
  "ci": {
    "commands": [
      "npm ci",
      "npm run build",
      "npm run lint:contract:built",
      "npm test"
    ]
  }
}
