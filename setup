#!/usr/bin/env bash
set -e

# ── hy-workflow: one‑command project setup (idempotent) ──────
#   ✓ 只安装缺失的，不覆盖已有配置
#   ✓ 已有 → 显示保留
#   ✓ 缺失 → 创建默认值
#   ✓ 输出 LLM agent prompt

echo ""
echo "  ┌──────────────────────────────────────┐"
echo "  │  hy-workflow · 项目级 MCP 一键部署  │"
echo "  └──────────────────────────────────────┘"
echo ""

# ── helpers ──────────────────────────────────────────────────

CREATED=()
SKIPPED=()
PASS=0
SKIP=0

_created() { CREATED+=("$1"); PASS=$((PASS + 1)); echo "  ✓ $1 (created)"; }
_skipped() { SKIPPED+=("$1"); SKIP=$((SKIP + 1)); echo "  ○ $1 (already exists, kept)"; }

# ── codelint ─────────────────────────────────────────────────

echo "  ⏳ codelint ..."
npx --yes github:voxServalG/codelint check --json >/dev/null 2>&1 && _have_lint=true || _have_lint=false

if [ -f codelint.json ]; then
  _skipped "codelint.json"
else
  cat > codelint.json <<'CODELINT'
{
  "codeDirs": ["src"],
  "codeExt": ".py",
  "baseBranch": "dev",
  "maxLines": 500
}
CODELINT
  _created "codelint.json"
fi

# ── doclint ──────────────────────────────────────────────────

echo "  ⏳ doclint ..."
npx --yes github:voxServalG/doclint lint --json >/dev/null 2>&1 && _have_doclint=true || _have_doclint=false

if [ -f doclint.json ]; then
  _skipped "doclint.json"
else
  cat > doclint.json <<'DOCLINT'
{
  "docsDir": "docs",
  "codeDirs": ["src", "tests"],
  "codeExt": ".py",
  "baseBranch": "dev",
  "maxLines": 200
}
DOCLINT
  _created "doclint.json"
fi

# ── docs-gardener ────────────────────────────────────────────

echo "  ⏳ docs-gardener ..."
if [ -f docs-gardener.json ]; then
  _skipped "docs-gardener.json"
elif [ -f doclint.json ]; then
  python3 -c "
import json, sys
try:
    with open('doclint.json') as f:
        d = json.load(f)
    gardener = {k: v for k, v in d.items() if k in ('docsDir','codeDirs','codeExt','baseBranch')}
    gardener['catalogs'] = {}
    with open('docs-gardener.json','w') as f:
        json.dump(gardener, f, indent=2, ensure_ascii=False)
        f.write('\n')
    print('OK')
except Exception:
    sys.exit(1)
" 2>/dev/null && _created "docs-gardener.json (from doclint.json)" || {
    cat > docs-gardener.json <<'GARDENER'
{
  "docsDir": "docs",
  "codeDirs": ["src", "tests"],
  "codeExt": ".py",
  "baseBranch": "dev",
  "catalogs": {}
}
GARDENER
    _created "docs-gardener.json (default)"
  }
else
  _created "docs-gardener.json"
fi

# ── CI workflows ─────────────────────────────────────────────

echo "  ⏳ CI workflows ..."
mkdir -p .github/workflows

if [ -f .github/workflows/code-quality.yml ]; then
  _skipped ".github/workflows/code-quality.yml"
else
  cat > .github/workflows/code-quality.yml <<'CI'
name: Code Quality
on:
  push: { paths: ["src/**", "codelint.json"] }
  pull_request: { paths: ["src/**", "codelint.json"] }
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: "20" }
      - run: npx --yes github:voxServalG/codelint check --json > report.json || true
      - run: |
          errors=$(jq '.errors' report.json)
          if [ "$errors" -gt 0 ]; then
            echo "::error::codelint found $errors errors"
            exit 1
          fi
CI
  _created ".github/workflows/code-quality.yml"
fi

if [ -f .github/workflows/docs-check.yml ]; then
  _skipped ".github/workflows/docs-check.yml"
else
  cat > .github/workflows/docs-check.yml <<'CIDOC'
name: Docs Lint
on:
  push: { paths: ["docs/**", "README.md"] }
  pull_request: { paths: ["docs/**", "README.md"] }
jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: "20" }
      - run: npx --yes github:voxServalG/doclint lint --json > report.json || true
      - run: |
          if [ $(jq '.failed' report.json) -gt 0 ]; then
            echo "::error::doclint found $(jq '.failed' report.json) errors"
            exit 1
          fi
CIDOC
  _created ".github/workflows/docs-check.yml"
fi

# ── MCP 配置检查（仅提醒，不改文件）─────────────────────────

PROJECT_ROOT=$(pwd)
PROJECT_NAME=$(basename "$PROJECT_ROOT")

_mcp_found=false
for f in ".opencode/opencode.json" ".mcp.json" ".opencode.json"; do
  if [ -f "$f" ]; then
    _mcp_found=true
    _mcp_file="$f"
    break
  fi
done

# ── Step 2: Output the LLM prompt ────────────────────────────

cat <<PROMPT

  ═══════════════════════════════════════════════════
  ✅  ${PASS} created, ${SKIP} kept · ${PROJECT_NAME}/
  ═══════════════════════════════════════════════════

PROMPT

if [ "$_mcp_found" = true ]; then
  cat <<ALREADY
  ℹ️  已检测到 MCP 配置: ${_mcp_file}
      请确保其中同时包含 hy-workflow 和 docs-gardener 条目，
      否则把下方配置合并进去。

ALREADY
fi

cat <<PROMPT
  📋 请将以下文字发送给你的 LLM agent：
  ═══════════════════════════════════════════════════

  ────── 复制以下内容发给 LLM ──────

  请为项目 ${PROJECT_NAME} 配置 hy-workflow 和 docs-gardener MCP（项目级，非全局）。

  1. 找到或创建项目根目录下的 MCP 配置文件：

      opencode     →  .opencode/opencode.json
      Claude Dsktp →  .mcp.json
      其他客户端   →  按其项目级 MCP 配置规范

  2. 确保配置中包含以下两个 server 条目（若已有其他 MCP，追加合并）：

  {
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
      "hy-workflow": {
        "type": "local",
        "command": ["npx", "-y", "github:voxServalG/hy-workflow-mcp"],
        "enabled": true
      },
      "docs-gardener": {
        "type": "local",
        "command": ["npx", "-y", "github:voxServalG/docs-gardener", "mcp"],
        "enabled": true
      }
    }
  }

  3. 配置完成后，调用 hy_init 初始化工作流状态。

  4. 之后任何代码/文档任务自动走 9 阶段闭环：
     hy_plan → hy_approve → hy_branch → hy_edit → hy_verify
     → hy_commit → hy_ci → hy_merge → hy_chain

  ────── 复制结束 ──────

  项目路径: ${PROJECT_ROOT}

PROMPT
