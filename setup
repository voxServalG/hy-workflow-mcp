#!/usr/bin/env bash
set -e

# ── hy-workflow: one-command project setup/update (idempotent) ──

SETUP_VERSION="2026.07.14.2"

echo ""
echo "  ┌──────────────────────────────────────┐"
echo "  │  hy-workflow · 项目级 MCP 一键部署  │"
echo "  └──────────────────────────────────────┘"
echo ""

CREATED=()
UPDATED=()
SKIPPED=()
PASS=0
SKIP=0

_created() { CREATED+=("$1"); PASS=$((PASS + 1)); echo "  ✓ $1 (created)"; }
_updated() { UPDATED+=("$1"); PASS=$((PASS + 1)); echo "  ✓ $1 (updated)"; }
_skipped() { SKIPPED+=("$1"); SKIP=$((SKIP + 1)); echo "  ○ $1 (up to date)"; }

write_file() {
  local file="$1"
  local tmp
  tmp=$(mktemp)
  cat > "$tmp"
  mkdir -p "$(dirname "$file")"
  if [ ! -f "$file" ]; then
    cp "$tmp" "$file"
    rm "$tmp"
    _created "$file"
  elif cmp -s "$tmp" "$file"; then
    rm "$tmp"
    _skipped "$file"
  else
    cp "$tmp" "$file"
    rm "$tmp"
    _updated "$file"
  fi
}

ensure_gitignore_line() {
  local item="$1"
  touch .gitignore
  if grep -qxF "$item" .gitignore; then
    _skipped ".gitignore:$item"
  else
    printf "%s\n" "$item" >> .gitignore
    _updated ".gitignore:$item"
  fi
}

PROJECT_ROOT=$(pwd)
PROJECT_NAME=$(basename "$PROJECT_ROOT")

echo "  ⏳ bootstrap artifacts ..."

write_file ".github/workflows/hy-workflow.yml" <<'YAML'
name: hy-workflow

on:
  push:
    paths:
      - ".github/workflows/**"
      - "src/**"
      - "test/**"
      - "tests/**"
      - "docs/**"
      - "README.md"
      - "AGENTS.md"
      - "setup"
      - "setup.ps1"
      - "hy-workflow.json"
      - "package.json"
      - "package-lock.json"
      - "tsconfig.json"
  pull_request:
    paths:
      - ".github/workflows/**"
      - "src/**"
      - "test/**"
      - "tests/**"
      - "docs/**"
      - "README.md"
      - "AGENTS.md"
      - "setup"
      - "setup.ps1"
      - "hy-workflow.json"
      - "package.json"
      - "package-lock.json"
      - "tsconfig.json"
  workflow_dispatch:

jobs:
  verify:
    name: Verify
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: "20" }
      - run: npm ci
      - name: Run package CI scripts
        run: |
          node <<'NODE'
          const fs = require('fs');
          const cp = require('child_process');
          const pkg = fs.existsSync('package.json') ? JSON.parse(fs.readFileSync('package.json', 'utf8')) : {};
          const scripts = pkg.scripts || {};
          const run = (label, command) => {
            console.log('::group::' + label);
            cp.execSync(command, { stdio: 'inherit' });
            console.log('::endgroup::');
          };
          if (scripts.build) run('build', 'npm run build');
          if (scripts['lint:contract']) run('lint:contract', 'npm run lint:contract');
          if (scripts.test) run('test', 'npm test');
          NODE
      - name: Materialize legacy lint configs
        run: |
          node <<'NODE'
          const fs = require('fs');
          const config = JSON.parse(fs.readFileSync('hy-workflow.json', 'utf8'));
          const project = config.project || {};
          const codelint = config.codelint || {};
          const doclint = config.doclint || {};
          const gardener = config.docsGardener || {};
          const write = (file, value) => fs.writeFileSync(file, JSON.stringify(value, null, 2) + '\n');
          write('codelint.json', { lintDirs: codelint.lintDirs, codeDirs: project.codeDirs, codeExt: project.codeExt, baseBranch: project.baseBranch, maxLines: codelint.maxLines });
          write('doclint.json', { docsDir: project.docsDir, codeDirs: project.codeDirs, codeExt: project.codeExt, baseBranch: project.baseBranch, maxLines: doclint.maxLines });
          write('docs-gardener.json', { docsDir: project.docsDir, codeDirs: project.codeDirs, codeExt: project.codeExt, baseBranch: project.baseBranch, catalogs: gardener.catalogs || {} });
          NODE
      - run: npx --yes github:voxServalG/doclint lint --json > doclint-report.json || true
      - name: Fail if doclint errors
        run: |
          failed=$(jq '.failed // .data.counts.failed // .data.summary.failed // .counts.failed // .summary.failed // 0' doclint-report.json)
          if [ "$failed" -gt 0 ]; then
            echo "::error::doclint found $failed errors"
            exit 1
          fi
      - run: npx --yes github:voxServalG/codelint check --json > codelint-report.json || true
      - name: Fail if codelint errors
        run: |
          errors=$(jq '.errors // .data.errors // 0' codelint-report.json)
          if [ "$errors" -gt 0 ]; then
            echo "::error::codelint found $errors errors"
            exit 1
          fi
YAML

if [ -f ".github/workflows/code-quality.yml" ]; then rm ".github/workflows/code-quality.yml"; _updated ".github/workflows/code-quality.yml (removed)"; fi
if [ -f ".github/workflows/docs-check.yml" ]; then rm ".github/workflows/docs-check.yml"; _updated ".github/workflows/docs-check.yml (removed)"; fi

CONFIG_RESULT=$(node <<'NODE'
const fs = require('fs');
const path = require('path');

function exists(rel) { return fs.existsSync(path.join(process.cwd(), rel)); }
function readJson(file) { return exists(file) ? JSON.parse(fs.readFileSync(file, 'utf8')) : null; }
function writeJson(file, value) {
  const next = JSON.stringify(value, null, 2) + '\n';
  const prev = exists(file) ? fs.readFileSync(file, 'utf8') : null;
  if (prev === next) return 'kept';
  fs.writeFileSync(file, next, 'utf8');
  return prev === null ? 'created' : 'updated';
}
function walk(dir, ext) {
  const start = path.join(process.cwd(), dir);
  if (!fs.existsSync(start)) return 0;
  let count = 0;
  for (const entry of fs.readdirSync(start, { withFileTypes: true })) {
    if (['node_modules', '.git', 'dist'].includes(entry.name)) continue;
    const full = path.join(start, entry.name);
    if (entry.isDirectory()) count += walk(path.relative(process.cwd(), full), ext);
    else if (entry.name.endsWith(ext)) count++;
  }
  return count;
}
function dirs(ext) {
  const candidates = ['src', 'tests', 'scripts', 'lib', 'packages'].filter(d => exists(d) && fs.statSync(d).isDirectory());
  return candidates.filter(d => walk(d, ext) > 0);
}
function extCounts() {
  const candidates = ['src', 'tests', 'scripts', 'lib', 'packages'].filter(d => exists(d) && fs.statSync(d).isDirectory());
  const counts = new Map();
  function scan(dir) {
    const start = path.join(process.cwd(), dir);
    if (!fs.existsSync(start)) return;
    for (const entry of fs.readdirSync(start, { withFileTypes: true })) {
      if (['node_modules', '.git', 'dist'].includes(entry.name)) continue;
      const full = path.join(start, entry.name);
      if (entry.isDirectory()) scan(path.relative(process.cwd(), full));
      else {
        const ext = path.extname(entry.name);
        if (ext) counts.set(ext, (counts.get(ext) || 0) + 1);
      }
    }
  }
  for (const dir of candidates) scan(dir);
  return counts;
}
function detectExt() {
  const pyScore = ['pyproject.toml', 'requirements.txt', 'setup.py', 'setup.cfg'].filter(exists).length * 3 + dirs('.py').length;
  const tsScore = ['tsconfig.json', 'package.json'].filter(exists).length * 3 + dirs('.ts').length;
  if (pyScore > tsScore) return '.py';
  if (tsScore > 0) return '.ts';
  const [first] = [...extCounts().entries()].sort((a, b) => b[1] - a[1]);
  return first ? first[0] : '.ts';
}
const ext = detectExt();
const codeDirs = dirs(ext).length ? dirs(ext) : (exists('src') ? ['src'] : ['src']);
const suggestion = {
  lintDirs: exists('src') ? ['src'] : codeDirs,
  codeDirs,
  codeExt: ext,
  baseBranch: 'dev',
  docsDir: 'docs',
  maxCodeLines: 500,
  maxDocLines: 200
};
const unified = readJson('hy-workflow.json');
const codelint = readJson('codelint.json');
const doclint = readJson('doclint.json');
const gardener = readJson('docs-gardener.json');
const project = (unified && unified.project) || {};
const codeSection = (unified && unified.codelint) || {};
const docsSection = (unified && unified.doclint) || {};
const gardenerSection = (unified && unified.docsGardener) || {};
const nextUnified = {
  ...(unified || {}),
  project: {
    ...project,
    baseBranch: project.baseBranch || codelint?.baseBranch || doclint?.baseBranch || gardener?.baseBranch || suggestion.baseBranch,
    codeExt: project.codeExt || codelint?.codeExt || doclint?.codeExt || gardener?.codeExt || suggestion.codeExt,
    codeDirs: project.codeDirs || doclint?.codeDirs || gardener?.codeDirs || codelint?.codeDirs || suggestion.codeDirs,
    docsDir: project.docsDir || doclint?.docsDir || gardener?.docsDir || suggestion.docsDir
  },
  codelint: {
    ...codeSection,
    lintDirs: codeSection.lintDirs || codelint?.lintDirs || suggestion.lintDirs,
    maxLines: codeSection.maxLines || codelint?.maxLines || suggestion.maxCodeLines
  },
  doclint: {
    ...docsSection,
    maxLines: docsSection.maxLines || doclint?.maxLines || suggestion.maxDocLines
  },
  docsGardener: {
    ...gardenerSection,
    catalogs: gardenerSection.catalogs || gardener?.catalogs || {}
  }
};
const source = nextUnified.project;
const nextCode = nextUnified.codelint;
const nextDocs = nextUnified.doclint;
const nextGardener = nextUnified.docsGardener;
const next = { 'hy-workflow.json': nextUnified };
for (const [file, value] of Object.entries(next)) console.log(`${file}:${writeJson(file, value)}`);
NODE
)
while IFS= read -r line; do
  file=${line%%:*}
  status=${line##*:}
  case "$status" in
    created) _created "$file" ;;
    updated) _updated "$file" ;;
    *) _skipped "$file" ;;
  esac
done <<< "$CONFIG_RESULT"

ensure_gitignore_line ".hy/"
ensure_gitignore_line ".opencode/"
ensure_gitignore_line ".codex/"
ensure_gitignore_line ".mcp.json"
ensure_gitignore_line "codelint.json"
ensure_gitignore_line "doclint.json"
ensure_gitignore_line "docs-gardener.json"

mkdir -p .git/hy-workflow
GENERATED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
write_file ".git/hy-workflow/setup.json" <<JSON
{
  "schemaVersion": "1",
  "setupVersion": "${SETUP_VERSION}",
  "generatedAt": "${GENERATED_AT}",
  "artifacts": [
    ".github/workflows/hy-workflow.yml",
    "hy-workflow.json"
  ]
}
JSON

cat <<PROMPT

  ═══════════════════════════════════════════════════
  ✅  ${PASS} created/updated, ${SKIP} kept · ${PROJECT_NAME}/
  ═══════════════════════════════════════════════════

  📋 请将以下文字发送给你的 LLM agent：
  ═══════════════════════════════════════════════════

  ────── 复制以下内容发给 LLM ──────

  项目 ${PROJECT_NAME} 已部署 hy-workflow bootstrap。

  理想项目状态：

  1. 应提交的项目产物只有：
     - .github/workflows/hy-workflow.yml
     - AGENTS.md
     - .gitignore
     - hy-workflow.json

  2. 不应提交的本地、运行时、客户端产物：
     - .hy/
     - .opencode/
     - .codex/
     - .mcp.json
     - codelint.json
     - doclint.json
     - docs-gardener.json

  3. hy-workflow.json 是唯一人工维护配置源。doclint/codelint/docs-gardener 需要旧配置文件时，由 hy-workflow 在运行时临时生成兼容配置；不要把这些兼容 JSON 当成项目源文件。

  4. MCP 客户端配置属于用户本地环境。只有在用户明确要求配置某个客户端时，才按该客户端的项目级 MCP 配置规范写入：
     - OpenCode: .opencode/opencode.json
     - Codex: .codex/config.toml
     - Claude Desktop 或其他客户端: .mcp.json 或其项目级配置规范

  5. 两个 CLI 必须通过 npm 全局安装或更新。默认 registry：
     npm install -g @voxstudio/hy-workflow@latest @voxstudio/docs-gardener@latest
     国内网络需要镜像时可改用：
     npm install -g @voxstudio/hy-workflow@latest @voxstudio/docs-gardener@latest --registry=https://registry.npmmirror.com

  6. 客户端里需要两个直接运行的 server，不要使用 npx、GitHub 地址或 SSH：
     - hy-workflow: command = hy-workflow，无 args
     - docs-gardener: command = docs-gardener，args = [mcp]

  7. 配置完成后，重启 agent/MCP session，并调用 hy_init 完成工作流状态初始化。hy_init 不会运行 setup，也不会启动交互式 TUI。

  8. 之后任何代码/文档任务自动走闭环：
     hy_status → hy_read_docs(before_plan) → hy_plan
     → hy_read_docs(before_approve) → hy_approve
     → hy_branch → hy_edit → hy_read_docs(after_edit)
     → hy_sync_docs → hy_verify
     → hy_commit → hy_ci → hy_merge → hy_chain

     hy_read_docs 是 agent 自动步骤，不是新增人类审核 gate。
     hy_plan 返回后，必须原样完整展示 summary，等用户明确 approve 后才可继续。
     hy_edit 后必须先调用 hy_read_docs(after_edit)，再调用 hy_sync_docs，最后才调用 hy_verify。
     hy_verify 若返回 amend_required，先展示 suggestedAmendment；用户明确批准后调用 hy_amend_plan，再重新走 hy_read_docs(after_edit) → hy_sync_docs → hy_verify。

  9. 如果 setup 后出现 diff，由 agent 自行判断如何把工作区调整到上面的理想状态；不要因为仍有本地产物就新增无关提交。

   ────── 复制结束 ──────

   项目路径: ${PROJECT_ROOT}

PROMPT
