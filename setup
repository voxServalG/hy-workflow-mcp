#!/usr/bin/env bash
set -e

# ── hy-workflow: one‑command project setup (idempotent) ──────
#   ✓ 只安装缺失的，不覆盖已有配置
#   ✓ 已有 → 显示保留
#   ✓ 缺失 → 创建默认值
#   ✓ 输出 LLM agent prompt

echo ""
echo "  ┌──────────────────────────────────────┐"
echo "  │  hy-workflow · 项目级 MCP 一键部署  │"
echo "  └──────────────────────────────────────┘"
echo ""

# ── helpers ──────────────────────────────────────────────────

CREATED=()
SKIPPED=()
PASS=0
SKIP=0

_created() { CREATED+=("$1"); PASS=$((PASS + 1)); echo "  ✓ $1 (created)"; }
_skipped() { SKIPPED+=("$1"); SKIP=$((SKIP + 1)); echo "  ○ $1 (already exists, kept)"; }

# ── hy-harness (unified deploy engine) ──────────────────────

echo "  ⏳ hy-harness ..."
npx --yes github:voxServalG/hy-harness && _created "hy-harness deployment" || {
  echo "  ✗ hy-harness failed. Ensure Node.js >= 18."
  exit 1
}

# ── MCP 配置检查（仅提醒，不改文件）─────────────────────────

PROJECT_ROOT=$(pwd)
PROJECT_NAME=$(basename "$PROJECT_ROOT")

_mcp_found=false
for f in ".opencode/opencode.json" ".mcp.json" ".opencode.json"; do
  if [ -f "$f" ]; then
    _mcp_found=true
    _mcp_file="$f"
    break
  fi
done

# ── Step 2: Output the LLM prompt ────────────────────────────

cat <<PROMPT

  ═══════════════════════════════════════════════════
  ✅  ${PASS} created, ${SKIP} kept · ${PROJECT_NAME}/
  ═══════════════════════════════════════════════════

PROMPT

if [ "$_mcp_found" = true ]; then
  cat <<ALREADY
  ℹ️  已检测到 MCP 配置: ${_mcp_file}
      请确保其中同时包含 hy-workflow 和 docs-gardener 条目，
      否则把下方配置合并进去。

      重要：两个 MCP 的 command 都必须包含 "--prefer-online"，
      否则重启不会拉取最新代码：
        hy-workflow:    ["npx", "-y", "--prefer-online", "github:voxServalG/hy-workflow-mcp"]
        docs-gardener:  ["npx", "-y", "--prefer-online", "github:voxServalG/docs-gardener", "mcp"]

ALREADY
fi

cat <<PROMPT
  📋 请将以下文字发送给你的 LLM agent：
  ═══════════════════════════════════════════════════

  ────── 复制以下内容发给 LLM ──────

  请为项目 ${PROJECT_NAME} 配置 hy-workflow 和 docs-gardener MCP（项目级，非全局）。

  1. 找到或创建项目根目录下的 MCP 配置文件：

      opencode     →  .opencode/opencode.json
      Claude Dsktp →  .mcp.json
      其他客户端   →  按其项目级 MCP 配置规范

  2. 确保配置中包含以下两个 server 条目（若已有其他 MCP，追加合并）：

  {
    "\$schema": "https://opencode.ai/config.json",
    "mcp": {
      "hy-workflow": {
        "type": "local",
        "command": ["npx", "-y", "--prefer-online", "github:voxServalG/hy-workflow-mcp"],
        "enabled": true
      },
      "docs-gardener": {
        "type": "local",
        "command": ["npx", "-y", "--prefer-online", "github:voxServalG/docs-gardener", "mcp"],
        "enabled": true
      }
    }
  }

  3. 配置完成后，调用 hy_init 初始化工作流状态。

  4. 之后任何代码/文档任务自动走 9 阶段闭环：
     hy_plan → hy_approve → hy_branch → hy_edit → hy_verify
     → hy_commit → hy_ci → hy_merge → hy_chain

   ────── 复制结束 ──────

   项目路径: ${PROJECT_ROOT}

PROMPT


