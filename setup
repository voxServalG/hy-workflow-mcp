#!/usr/bin/env bash
set -e

# ── hy-workflow: one‑command project setup ──────────────────
# 1. Deploys hy-harness (codelint + doclint + CI)
# 2. Outputs a prompt for your LLM agent to finish the MCP config

echo ""
echo "  ┌──────────────────────────────────────┐"
echo "  │  hy-workflow · 项目级 MCP 一键部署  │"
echo "  └──────────────────────────────────────┘"
echo ""

# ── Step 1: Deploy harness ──────────────────────────────────
echo "  ⏳ Deploying codelint + doclint ..."
npx --yes github:voxServalG/codelint init --yes 2>/dev/null || {
  cat > codelint.json <<'CODELINT'
{
  "codeDirs": ["src"],
  "codeExt": ".py",
  "baseBranch": "dev",
  "maxLines": 500
}
CODELINT
  echo "  ✓ codelint.json"
}

npx --yes github:voxServalG/doclint init --yes 2>/dev/null || {
  cat > doclint.json <<'DOCLINT'
{
  "docsDir": "docs",
  "codeDirs": ["src", "tests"],
  "codeExt": ".py",
  "baseBranch": "dev",
  "maxLines": 200
}
DOCLINT
  echo "  ✓ doclint.json"
}

# CI workflows
mkdir -p .github/workflows

cat > .github/workflows/code-quality.yml <<'CI'
name: Code Quality
on:
  push: { paths: ["src/**", "codelint.json"] }
  pull_request: { paths: ["src/**", "codelint.json"] }
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: "20" }
      - run: npx --yes github:voxServalG/codelint check --json > report.json || true
      - run: |
          errors=$(jq '.errors' report.json)
          if [ "$errors" -gt 0 ]; then
            echo "::error::codelint found $errors errors"
            exit 1
          fi
CI
echo "  ✓ .github/workflows/code-quality.yml"

cat > .github/workflows/docs-check.yml <<'CIDOC'
name: Docs Lint
on:
  push: { paths: ["docs/**", "README.md"] }
  pull_request: { paths: ["docs/**", "README.md"] }
jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: "20" }
      - run: npx --yes github:voxServalG/doclint lint --json > report.json || true
      - run: |
          if [ $(jq '.failed' report.json) -gt 0 ]; then
            echo "::error::doclint found $(jq '.failed' report.json) errors"
            exit 1
          fi
CIDOC
echo "  ✓ .github/workflows/docs-check.yml"

# ── Step 2: Output the LLM prompt ────────────────────────────

PROJECT_ROOT=$(pwd)
PROJECT_NAME=$(basename "$PROJECT_ROOT")

cat <<PROMPT

  ═══════════════════════════════════════════════════
  ✅  Harness deployed to ${PROJECT_NAME}/

  📋 请将以下文字发送给你的 LLM agent：
  ═══════════════════════════════════════════════════

  ────── 复制以下内容发给 LLM ──────

  请为项目 ${PROJECT_NAME} 配置 hy-workflow MCP（项目级，非全局）。

  1. 创建或编辑项目根目录下的 MCP 配置文件。

     如果使用 opencode，编辑 .opencode/mcp.json；
     如果使用 Claude Desktop，编辑 .mcp.json；
     如果使用其他客户端，按照其项目级 MCP 配置规范。

  2. 写入以下配置：

  {
    "mcpServers": {
      "hy-workflow": {
        "command": "npx",
        "args": ["-y", "github:voxServalG/hy-workflow-mcp"]
      }
    }
  }

  3. 配置完成后，在项目根目录调用 hy_init 初始化工作流状态。

  4. 之后任何代码/文档编辑任务，都会自动走 9 阶段闭环：
     hy_plan → hy_approve → hy_branch → hy_edit → hy_verify
     → hy_commit → hy_ci → hy_merge → hy_chain

  ────── 复制结束 ──────

  项目路径: ${PROJECT_ROOT}

PROMPT
