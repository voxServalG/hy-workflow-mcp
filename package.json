{
  "name": "@voxstudio/hy-workflow",
  "version": "0.6.1",
  "description": "Free Git-native incident and invariant evidence protocol for coding Agents",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "hy-workflow": "dist/main.js"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc",
    "dev": "npx tsx src/main.ts",
    "test:run": "node -e \"const fs=require('node:fs'),path=require('node:path'),cp=require('node:child_process'),tsx=require.resolve('tsx/cli'),dir=process.argv[1];for(const name of fs.readdirSync(dir).filter(name=>name.endsWith('.ts')).sort()){const child=cp.spawnSync(process.execPath,[tsx,path.join(dir,name)],{stdio:'inherit',env:{...process.env}});if(child.error){console.error(child.error.message);process.exit(1)}if(child.status!==0)process.exit(child.status??1)}\"",
    "test:unit": "npm run test:run -- test/unit",
    "test:e2e": "npm run test:run -- test/e2e",
    "test:contract": "npm run test:run -- test/contract",
    "test": "npm run test:unit && npm run test:e2e && npm run test:contract",
    "verify": "npm run build && npm test",
    "test:acceptance:thin": "npx tsx test/acceptance/thin-package.ts",
    "test:acceptance:migration": "npx tsx test/acceptance/public-0.5-upgrade.ts",
    "test:windows": "node scripts/windows-smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "author": "Haiyi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxServalG/hy-workflow-mcp.git"
  },
  "homepage": "https://github.com/voxServalG/hy-workflow-mcp#readme",
  "bugs": {
    "url": "https://github.com/voxServalG/hy-workflow-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "picomatch": "^4.0.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "schemas",
    "templates",
    "skills",
    "LICENSE",
    "README.md"
  ]
}
