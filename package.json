{
  "name": "@voxstudio/hy-workflow",
  "version": "0.4.1-next.3",
  "description": "MCP server enforcing a closed-loop workflow for LLM-assisted development",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "hy-workflow": "dist/server.js"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc",
    "start": "node dist/server.js",
    "dev": "npx tsx src/server.ts",
    "lint:contract": "npm run build && npm run lint:contract:built",
    "lint:contract:built": "node dist/contralint/index.js",
    "test:run": "node -e \"const fs=require('node:fs'),path=require('node:path'),cp=require('node:child_process'),tsx=require.resolve('tsx/cli');const dir=process.argv[1];for(const name of fs.readdirSync(dir).filter(name=>name.endsWith('.ts')).sort()){const child=cp.spawnSync(process.execPath,[tsx,path.join(dir,name)],{stdio:'inherit'});if(child.error){console.error(child.error.message);process.exit(1)}if(child.status!==0)process.exit(child.status??1)}\"",
    "test:unit": "npm run test:run -- test/unit",
    "test:e2e": "npm run test:run -- test/e2e",
    "test:contract": "npm run test:run -- test/contract",
    "test:acceptance:baseline": "npx tsx test/acceptance/baseline-runner.ts",
    "test:acceptance:pressure": "npx tsx test/acceptance/runner.ts --profile release",
    "test:acceptance": "npm run test:acceptance:pressure",
    "test:windows": "node scripts/windows-smoke.mjs",
    "test": "npm run test:unit && npm run test:e2e && npm run test:contract",
    "verify": "npm run build && npm test",
    "verify:dev": "npm run verify && npm run test:acceptance:baseline",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "test:dist": "npx tsx test/contract/dist-artifacts.ts",
    "test:doclint-output": "npx tsx test/unit/doclint-output.ts",
    "test:setup-update": "npx tsx test/e2e/setup-update-check.ts",
    "test:config-update": "npx tsx test/unit/config-update.ts"
  },
  "author": "Haiyi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxServalG/hy-workflow-mcp.git"
  },
  "homepage": "https://github.com/voxServalG/hy-workflow-mcp#readme",
  "bugs": {
    "url": "https://github.com/voxServalG/hy-workflow-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "docs",
    "templates",
    "AGENTS.md",
    "README.md"
  ]
}
