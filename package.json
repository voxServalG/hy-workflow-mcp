{
  "name": "@voxserval/hy-workflow",
  "version": "0.1.0",
  "description": "MCP server enforcing a closed-loop workflow for LLM-assisted development",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "hy-workflow": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "npx tsx src/server.ts",
    "lint:contract": "npm run build && npm run lint:contract:built",
    "lint:contract:built": "node dist/contralint/index.js",
    "test:unit": "for f in test/unit/*.ts; do npx tsx \"$f\" || exit 1; done",
    "test:e2e": "for f in test/e2e/*.ts; do npx tsx \"$f\" || exit 1; done",
    "test:contract": "for f in test/contract/*.ts; do npx tsx \"$f\" || exit 1; done",
    "test": "npm run test:unit && npm run test:e2e && npm run test:contract",
    "verify": "npm run build && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run verify",
    "test:dist": "npx tsx test/contract/dist-artifacts.ts",
    "test:doclint-output": "npx tsx test/unit/doclint-output.ts",
    "test:setup-update": "npx tsx test/e2e/setup-update-check.ts",
    "test:config-update": "npx tsx test/unit/config-update.ts"
  },
  "author": "Haiyi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxServalG/hy-workflow-mcp.git"
  },
  "homepage": "https://github.com/voxServalG/hy-workflow-mcp#readme",
  "bugs": {
    "url": "https://github.com/voxServalG/hy-workflow-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.0.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "docs",
    "setup",
    "setup.ps1",
    "README.md"
  ]
}
