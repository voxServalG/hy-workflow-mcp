{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/voxServalG/hy-workflow-mcp/main/schemas/hy-workflow.schema.json",
  "title": "hy-workflow project configuration",
  "type": "object",
  "required": ["version", "project", "codelint"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/voxServalG/hy-workflow-mcp/main/schemas/hy-workflow.schema.json" },
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["baseBranch", "codeExt", "codeDirs", "docsDir"],
      "properties": {
        "baseBranch": { "type": "string", "minLength": 1, "maxLength": 200 },
        "codeExt": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "codeDirs": { "$ref": "#/$defs/paths" },
        "docsDir": { "$ref": "#/$defs/path" }
      },
      "additionalProperties": true
    },
    "ci": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$" }
        }
      },
      "additionalProperties": true
    },
    "codelint": {
      "type": "object",
      "required": ["lintDirs"],
      "properties": {
        "lintDirs": { "$ref": "#/$defs/paths" },
        "maxLines": { "$ref": "#/$defs/positiveInteger" },
        "maxLinesWarning": { "$ref": "#/$defs/positiveInteger" },
        "maxLinesError": { "$ref": "#/$defs/positiveInteger" },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "deprecated": true,
          "description": "Compatibility-only legacy field. It is preserved but ignored; dependency/module lint is not provided and C003 remains not_configured.",
          "items": {
            "type": "object",
            "required": ["name", "paths"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "paths": { "$ref": "#/$defs/paths" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "doclint": {
      "type": "object",
      "properties": {
        "maxLines": { "$ref": "#/$defs/positiveInteger" },
        "maxLinesWarning": { "$ref": "#/$defs/positiveInteger" },
        "maxLinesError": { "$ref": "#/$defs/positiveInteger" }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "properties": {
        "profile": { "enum": ["relaxed", "standard", "strict"] },
        "rules": { "$ref": "#/$defs/ruleMap" },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["files", "rules"],
            "properties": {
              "files": { "$ref": "#/$defs/globs" },
              "rules": { "$ref": "#/$defs/ruleMap" }
            },
            "additionalProperties": false
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule", "files", "reason", "owner", "expires"],
            "properties": {
              "rule": { "$ref": "#/$defs/qualityRuleId" },
              "files": { "$ref": "#/$defs/globs" },
              "reason": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 },
              "issue": { "type": "string", "minLength": 1 },
              "expires": { "type": "string", "format": "date" },
              "severity": { "enum": ["off", "advisory", "warning"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "path": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?![-/])(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
    "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "glob": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^(?![-/])(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/*?-]+$" },
    "globs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/glob" } },
    "qualityRuleId": {
      "enum": [
        "docs.reachability",
        "docs.links",
        "docs.structure",
        "docs.max-lines",
        "code.max-lines"
      ]
    },
    "ruleConfig": {
      "type": "object",
      "properties": {
        "severity": { "enum": ["off", "advisory", "warning", "error"] },
        "warning": { "$ref": "#/$defs/positiveInteger" },
        "error": { "$ref": "#/$defs/positiveInteger" }
      },
      "additionalProperties": false
    },
    "severityRuleConfig": {
      "type": "object",
      "properties": {
        "severity": { "enum": ["off", "advisory", "warning", "error"] }
      },
      "additionalProperties": false
    },
    "ruleMap": {
      "type": "object",
      "properties": {
        "docs.reachability": { "$ref": "#/$defs/severityRuleConfig" },
        "docs.links": { "$ref": "#/$defs/severityRuleConfig" },
        "docs.structure": { "$ref": "#/$defs/severityRuleConfig" },
        "docs.max-lines": { "$ref": "#/$defs/ruleConfig" },
        "code.max-lines": { "$ref": "#/$defs/ruleConfig" }
      },
      "additionalProperties": false
    }
  }
}
